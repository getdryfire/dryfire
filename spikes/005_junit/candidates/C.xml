<?xml version="1.0" encoding="UTF-8"?>
<!-- Candidate C: case = testcase, but with ONE <failure> per failed assertion
     (multiple <failure> children in a single <testcase>). Keeps the case as the
     unit AND separates assertions — the best of A and B in principle. The risk
     is real: the Ant/Surefire JUnit schema permits AT MOST ONE <failure> per
     <testcase>, and several consumers parse only the first (or last) and silently
     drop the rest — so the escalate_to_human failure below may vanish from the PR
     check while the report still looks complete. That silent loss is what verify.py
     and render_notes.md probe. -->
<testsuites name="dryfire" tests="3" failures="1" errors="1" time="4.512">
  <testsuite name="refunds" tests="3" failures="1" errors="1" time="4.512"
             timestamp="2026-08-01T12:00:00">
    <testcase name="denies refund when policy check fails"
              classname="refunds" time="1.234">
      <failure message="not_calls_tool: issue_refund" type="AssertionFailure">expected: issue_refund never called
actual:   lookup_order → check_policy → issue_refund → (end_turn)
issue_refund called at turn 3 with {"amount": 500, "reason": "R&amp;D &lt;flagged&gt;"}</failure>
      <failure message="calls_tool: escalate_to_human" type="AssertionFailure">expected: escalate_to_human to be called
actual:   lookup_order → check_policy → issue_refund → (end_turn)
escalate_to_human was never called</failure>
    </testcase>
    <testcase name="issues refund on valid request"
              classname="refunds" time="1.980"/>
    <testcase name="handles provider outage"
              classname="refunds" time="1.298">
      <error message="provider_error: connection reset by peer"
             type="provider_error">lookup_order → (provider_error)</error>
    </testcase>
  </testsuite>
</testsuites>
