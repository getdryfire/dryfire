{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dryfire run artifact (schema_version 2)",
  "type": "object",
  "required": ["schema_version", "generated_at", "complete", "suites"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "complete": { "type": "boolean" },
    "suites": { "type": "array", "items": { "$ref": "#/$defs/suite" } }
  },
  "$defs": {
    "suite": {
      "type": "object",
      "required": ["name", "path", "cases"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } }
      }
    },
    "case": {
      "type": "object",
      "required": ["suite_name", "case_name", "passed", "error", "assertions", "trace"],
      "additionalProperties": false,
      "properties": {
        "suite_name": { "type": "string" },
        "case_name": { "type": "string" },
        "passed": { "type": "boolean" },
        "error": { "type": ["string", "null"] },
        "assertions": { "type": "array", "items": { "$ref": "#/$defs/assertion" } },
        "trace": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/trace" }] },
        "pass_rate": { "type": ["number", "null"] },
        "require_pass_rate": { "type": ["number", "null"] },
        "repetitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["passed", "error", "assertions", "trace"],
            "properties": {
              "passed": { "type": "boolean" },
              "error": { "type": ["string", "null"] },
              "assertions": { "type": "array", "items": { "$ref": "#/$defs/assertion" } },
              "trace": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/trace" }] }
            }
          }
        }
      }
    },
    "assertion": {
      "type": "object",
      "required": ["kind", "description", "passed", "message"],
      "properties": {
        "kind": { "type": "string" },
        "description": { "type": "string" },
        "passed": { "type": "boolean" },
        "message": { "type": "string" }
      }
    },
    "trace": {
      "type": "object",
      "required": [
        "case_name", "suite_name", "turns", "final_text",
        "termination", "total_usage", "total_cost_usd", "duration_ms"
      ],
      "properties": {
        "case_name": { "type": "string" },
        "suite_name": { "type": "string" },
        "turns": { "type": "array" },
        "final_text": { "type": ["string", "null"] },
        "termination": {
          "enum": [
            "end_turn", "max_turns_exceeded", "provider_error",
            "unmocked_tool", "max_tokens", "refusal"
          ]
        },
        "total_usage": { "$ref": "#/$defs/usage" },
        "total_cost_usd": { "type": ["number", "null"] },
        "duration_ms": { "type": "integer" },
        "error": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "judge_verdicts": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/judge_verdict" }
        },
        "judge_usage": { "$ref": "#/$defs/usage" },
        "judge_cost": { "type": ["number", "null"] }
      }
    },
    "judge_verdict": {
      "type": "object",
      "required": [
        "score", "passed", "reasoning", "judge_model",
        "judge_model_version", "rubric_hash", "threshold"
      ],
      "properties": {
        "score": { "type": "number" },
        "passed": { "type": "boolean" },
        "reasoning": { "type": "string" },
        "judge_model": { "type": "string" },
        "judge_model_version": { "type": "string" },
        "rubric_hash": { "type": "string" },
        "threshold": { "type": "number" }
      }
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens"],
      "properties": {
        "input_tokens": { "type": "integer" },
        "output_tokens": { "type": "integer" },
        "cache_read_tokens": { "type": "integer" },
        "cache_write_tokens": { "type": "integer" }
      }
    }
  }
}
